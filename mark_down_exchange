def level_set(points: Iterable[float], function: NumericFunction, low: float, high: float) -> list[float]:
    """Approximate a level set over sampled points."""
    return [x for x in points if low <= function(x) < high]


def approximate_measure(predicate: Predicate, a: float, b: float, n: int = 10_000) -> float:
    """Approximate the measure of a set in [a, b] by uniform sampling."""
    dx = (b - a) / n
    return sum(1 for i in range(n) if predicate(a + i * dx)) * dx


def integrate_indicator(predicate: Predicate, a: float, b: float, n: int = 10_000) -> float:
    """Approximate ∫χ_A dμ over [a, b]."""
    return approximate_measure(predicate, a, b, n)


def integrate_simple_function(terms: Sequence[tuple[float, Predicate]], a: float, b: float, n: int = 10_000) -> float:
    """Approximate the integral of a simple function: ∫s dμ = Σ a_i μ(A_i)."""
    total = 0.0
    for coefficient, predicate in terms:
        total += coefficient * approximate_measure(predicate, a, b, n)
    return total


def threshold_set(points: Iterable[float], function: NumericFunction, threshold: float) -> list[float]:
    """Approximate the threshold set {x : f(x) > threshold}."""
    return [x for x in points if function(x) > threshold]


